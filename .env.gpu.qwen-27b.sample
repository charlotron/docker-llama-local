# =================================================================
# CONFIGURATION FOR QWEN 3.8 27B DENSE GGUF - CUDA MODE
# =================================================================
# Alternate profile: swap ./scripts/docker/launch-server.sh's env-file argument
# to this one to run the dense 27B model instead of the default 35B A3B MoE.
# Launch with: ./scripts/docker/launch-server.sh .env.gpu.qwen-27b

# Docker Compose file for this profile
COMPOSE_FILE=docker/docker-compose-gpu-qwen-27b.yml

# MODEL
# Dense (all params active per token) 27B model, as opposed to the 35B A3B's
# 3B-active MoE routing. IQ4_XS + MTP is the best verified config on this
# hardware: 5.4 tok/s, confirmed swap-free (RTX 4070 Super 12GB VRAM / 23GB
# WSL RAM). Still far slower than the MoE profiles (35B A3B / gpt-oss-20b,
# both ~42 tok/s) -- this profile is for when you specifically need a dense
# model, not for speed. See docs/BENCHMARKS.md for the full comparison.
HF_REPO="unsloth/Qwen3.8-27B-GGUF"
HF_FILE="Qwen3.8-27B-UD-IQ4_XS.gguf"

# Local host to access llama-server
LLAMA_HOST=127.0.0.1
# Local port to access llama-server
LLAMA_PORT=12345

# Context size (measured in tokens)
# 393216 / 3 parallel slots = 131072 (128K) per slot, same floor as the 35B profile.
LLAMA_CONTEXT_SIZE=131072

# CPU Threads (Supposing you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=14

# Local storage path for GGUF model files (optional, defaults to "./docker/data/models" if left empty or commented out)
MODELS_DIR=""
