# =================================================================
# CONFIGURACIÓN DE INFRAESTRUCTURA (llama.cpp)
# =================================================================

# Repositorio oficial de Hugging Face
HF_REPO=Qwen/Qwen2.5-Coder-14B-Instruct-GGUF

# Archivo GGUF específico dentro del repositorio
HF_FILE=qwen2.5-coder-14b-instruct-q4_k_m.gguf

# Puerto local para acceder a llama-server
LLAMA_CPP_PORT=8133

# Tamaño de contexto (Claude Code envía prompts muy grandes, se recomienda 65536)
LLAMA_CPP_CTX_SIZE=65536

# Capas a descargar en GPU (999 para todas las posibles)
LLAMA_CPP_N_GL=999

# Nota: Los modelos se descargan automáticamente en la carpeta docker/data/
