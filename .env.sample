# =================================================================
# CONFIGURACIÓN DE INFRAESTRUCTURA (Docker Compose)
# =================================================================

# El modelo que Ollama descargará y servirá automáticamente.
OLLAMA_MODEL=gemma:26b

# Puertos locales para acceder a los servicios.
OLLAMA_PORT=11434
LITELLM_PORT=4000

# Si se establece a true, LiteLLM ignorará los modelos del config.yaml 
# y usará el valor de OLLAMA_MODEL para todos.
LITELLM_OVERRIDE_MODELS=true

# =================================================================
# RUTAS DE PERSISTENCIA (Excluidas en .gitignore)
# =================================================================

# Donde se almacenan los modelos descargados y datos internos.
OLLAMA_MODELS_PATH=./data/ollama/models
OLLAMA_CONFIG_PATH=./data/ollama/config

# Donde LiteLLM guarda sus logs.
LITELLM_DATA_PATH=./data/litellm
