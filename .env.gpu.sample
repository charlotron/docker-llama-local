# =================================================================
# CONFIGURATION FOR QWEN 3.6 35B A3B INSTRUCT GGUF - CUDA MODE
# =================================================================

# Docker Compose file for GPU
COMPOSE_FILE=docker/docker-compose-gpu.yml

# MODEL
# Recommended high-end model: Qwen3.6-35B-A3B (Unsloth Dynamic Q4_K_XL GGUF)
# Fits well in RTX 4070 Ti Super / RTX 4070 Super with hybrid CPU/GPU split.
# Tested system: RTX 4070 Super (12GB VRAM) | Ryzen 7 7700X | 32GB DDR5 @ 6000MHz.
# It offers state-of-the-art agentic tool calling and thinking capabilities.
HF_REPO="unsloth/Qwen3.6-35B-A3B-GGUF"
HF_FILE="Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf"

# Local host to access llama-server
LLAMA_HOST=127.0.0.1
# Local port to access llama-server
LLAMA_PORT=12345

# Context size (measured in tokens)
# 128k context size fits comfortably inside RAM/VRAM with Q8/Q4 cache quantization.
LLAMA_CONTEXT_SIZE=131072

# CPU Threads (Supposing you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=14

# Local storage path for GGUF model files (optional, defaults to "./docker/data/models" if left empty or commented out)
MODELS_DIR=""
