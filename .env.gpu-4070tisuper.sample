# =================================================================
# OPTIMIZED CONFIGURATION FOR NVIDIA RTX 4070 TI SUPER (16GB VRAM)
# =================================================================

# Docker Compose file for GPU
COMPOSE_FILE=docker/docker-compose-gpu.yml

# Recommended: Qwen2.5-Coder-32B (Q4_K_M) for 16GB VRAM
# This model offers a great balance between intelligence and speed
HF_REPO=Qwen/Qwen2.5-Coder-32B-Instruct-GGUF
HF_FILE=qwen2.5-coder-32b-instruct-q4_k_m.gguf

# Local port
LLAMA_PORT=12345

# Context size (measured in tokens)
# Works well with 32k or 64k for this model on 16GB VRAM
LLAMA_CONTEXT_SIZE=65536

# CPU Threads (Supose you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=12