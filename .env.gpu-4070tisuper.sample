# =================================================================
# OPTIMIZED CONFIGURATION FOR NVIDIA RTX 4070 TI SUPER (16GB VRAM)
# =================================================================

# Docker Compose file for GPU
COMPOSE_FILE=docker/docker-compose-gpu.yml

#MODEL
# Recommended: Qwopus3.5-9B-v3-GGUF for 16GB VRAM
# This model offers a great balance between intelligence and speed
#https://huggingface.co/Jackrong/Qwopus3.5-9B-v3-GGUF
#Probado en 4070 ti super
HF_REPO=jackrong/Qwopus3.5-9B-v3-GGUF
# More compressed model (faster-worse accuracy)
HF_FILE=Qwopus3.5-9B-v3.Q4_K_M.gguf
# Least compressed model (slower-better accuracy)
#HF_FILE=Qwopus3.5-9B-v3.Q8_0.gguf

# Local port
LLAMA_PORT=12345

# Context size (measured in tokens)
# 32k is optimized to fit this model + context within 16GB VRAM
LLAMA_CONTEXT_SIZE=32768

# CPU Threads (Optimized: 16 total threads - 2 = 14)
LLAMA_CPU_THREADS=14
