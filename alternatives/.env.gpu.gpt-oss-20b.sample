# =================================================================
# CONFIGURATION FOR GPT-OSS-20B GGUF - CUDA MODE
# =================================================================
# Alternate profile: swap ./scripts/docker/launch-server.sh's env-file argument
# to this one to run gpt-oss-20b instead of the default Qwen 35B A3B.
# Launch with: ./scripts/docker/launch-server.sh alternatives/.env.gpu.gpt-oss-20b

# Docker Compose file for this profile
COMPOSE_FILE=docker/alternatives/docker-compose-gpu-gpt-oss-20b.yml

# MODEL
# OpenAI open-weight MoE (~3.6B active params/token). Matches the 35B A3B+MTP
# champion's speed (~42 tok/s) with no speculative decoding needed, at about
# half the disk and a third of the RAM. See docs/BENCHMARKS.md before
# switching a production workload to this -- tool-call round-trip and length
# discipline still need verifying for your specific use case.
HF_REPO="unsloth/gpt-oss-20b-GGUF"
HF_FILE="gpt-oss-20b-UD-Q4_K_XL.gguf"

# Local host to access llama-server
LLAMA_HOST=127.0.0.1
# Local port to access llama-server
LLAMA_PORT=12345

# Context size (measured in tokens)
# 262144 / 2 parallel slots = 131072 (128K) per slot -- capped at gpt-oss-20b's native
# context ceiling on purpose (unlike the Qwen profiles, going past 128K here degrades
# quality rather than extending it).
LLAMA_CONTEXT_SIZE=131072

# CPU Threads (Supposing you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=14

# Local storage path for GGUF model files (optional, defaults to "./docker/data/models" if left empty or commented out)
MODELS_DIR=""
