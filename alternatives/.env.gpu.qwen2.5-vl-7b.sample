# =================================================================
# CONFIGURATION FOR QWEN2.5-VL-7B-INSTRUCT GGUF - CUDA MODE (VISION)
# =================================================================
# The only vision/multimodal profile in this repo. All 4 other profiles are
# text-only. Launch with: ./scripts/docker/launch-server.sh alternatives/.env.gpu.qwen2.5-vl-7b
# See docs/VISION_MODEL_EVAL.md for the full evaluation writeup (PDF-page
# analysis test, head-to-head vs. the 35B A3B text champion on the same PDF).

# Docker Compose file for this profile
COMPOSE_FILE=docker/alternatives/docker-compose-gpu-vision-qwen25vl.yml

# MODEL
# Qwen2.5-VL-7B-Instruct, Q8_0 quant, with its matching mmproj (vision projector).
# Both files are required -- without the mmproj, llama-server loads this as a
# text-only model with no image support. launch-server.sh downloads both
# automatically (HF_MMPROJ_FILE triggers the second download; unset it and this
# profile would fail with a missing --mmproj file).
HF_REPO="bartowski/Qwen_Qwen2.5-VL-7B-Instruct-GGUF"
HF_FILE="Qwen_Qwen2.5-VL-7B-Instruct-Q8_0.gguf"
HF_MMPROJ_FILE="mmproj-Qwen_Qwen2.5-VL-7B-Instruct-f16.gguf"

# Local host to access llama-server
LLAMA_HOST=127.0.0.1
# Local port to access llama-server
LLAMA_PORT=12345

# Context size (measured in tokens). 8192 covers a handful of page images plus
# prompt/response comfortably; raise if you need multi-page batches in one request.
LLAMA_CONTEXT_SIZE=8192

# CPU Threads (Supposing you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=14

# Local storage path for GGUF model files.
# IMPORTANT: point this at fast local/native storage, NOT a slow network or 9p-backed
# mount (e.g. a WSL2 path under /mnt/<drive-letter> backed by a Windows drive). Loading
# ~9.3GB of model+mmproj from such a mount measured ~15MB/s and could hang under some
# load-mode settings. Native Linux filesystem storage loaded in well under a minute.
MODELS_DIR=""
