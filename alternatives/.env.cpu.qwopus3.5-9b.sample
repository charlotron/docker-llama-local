# =================================================================
# INFRASTRUCTURE CONFIGURATION (llama.cpp) - CPU MODE
# =================================================================

# Docker Compose file for CPU
COMPOSE_FILE=docker/alternatives/docker-compose-cpu.yml

# MODEL
# Lighter model recommended for CPU execution to avoid extreme slowness.
# https://huggingface.co/Jackrong/Qwopus3.5-9B-v3-GGUF
HF_REPO="jackrong/Qwopus3.5-9B-v3-GGUF"
HF_FILE="Qwopus3.5-9B-v3.Q4_K_M.gguf"

# Local host to access llama-server
LLAMA_HOST=127.0.0.1
# Local port to access llama-server
LLAMA_PORT=12345

# Context size (measured in tokens)
# 32k is standard and manageable for CPU execution.
LLAMA_CONTEXT_SIZE=32768

# CPU Threads (Supposing you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=14

# Local storage path for GGUF model files
# Defaults to "./docker/data/models" if left empty or commented out.
MODELS_DIR=""
