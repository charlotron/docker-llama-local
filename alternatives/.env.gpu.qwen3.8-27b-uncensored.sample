# =================================================================
# CONFIGURATION FOR QWEN 27B HAUHAUCS-AGGRESSIVE (UNCENSORED) GGUF - CUDA MODE
# =================================================================
# Alternate profile: swap ./scripts/docker/launch-server.sh's env-file argument
# to this one to run the community "uncensored" HauhauCS-Aggressive fine-tune
# of the dense 27B model.
# Launch with: ./scripts/docker/launch-server.sh alternatives/.env.gpu.qwen3.8-27b-uncensored

# Docker Compose file for this profile
COMPOSE_FILE=docker/alternatives/docker-compose-gpu-qwen-27b-uncensored.yml

# MODEL
# Community fine-tune, not the official unsloth base line. IQ2_M is the best
# verified quant: 4.40 tok/s, swap-free (RTX 4070 Super 12GB VRAM / 23GB WSL
# RAM). MTP tensors are real in this GGUF but measured SLOWER (3.45 tok/s) --
# this profile deliberately runs without --spec-type draft-mtp. See
# BENCHMARKS.md "Round 7" and docs/BENCHMARKS.md for full evidence.
HF_REPO="HauhauCS/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-MTP-GGUF"
HF_FILE="Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-IQ2_M.gguf"

# Local host to access llama-server
LLAMA_HOST=127.0.0.1
# Local port to access llama-server
LLAMA_PORT=12345

# Context size (measured in tokens)
# 393216 / 3 parallel slots = 131072 (128K) per slot, same floor as every profile.
LLAMA_CONTEXT_SIZE=131072

# CPU Threads (Supposing you have 16 cores, total threads - 2 = 14)
LLAMA_CPU_THREADS=14

# Local storage path for GGUF model files (optional, defaults to "./docker/data/models" if left empty or commented out)
MODELS_DIR=""
